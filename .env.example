# En Render: Dashboard > Web Service > Environment.
# La URL debe provenir de TiDB Cloud > Connect (JDBC), con TLS habilitado.
DB_URL=jdbc:mysql://HOST_TIDB:4000/NOMBRE_BD?sslMode=VERIFY_IDENTITY&serverTimezone=UTC
DB_USER=USUARIO_TIDB
DB_PASSWORD=CONTRASENA_TIDB
# PORT es opcional; el Dockerfile usa 10000 por defecto.
PORT=10000
